{
  "name": "pruwear",
  "displayName": "Pruwear ✦ Virtual Try-On",
  "version": "1.0.0",
  "description": "Realtime AI Virtual Try-On powered by Lucy VTON 3.5 Neural Engine",
  "private": true,
  "type": "module",
  "scripts": {
    "prebundle": "node scripts/prebundle.mjs",
    "dev": "npm run prebundle && plasmo dev",
    "build": "npm run prebundle && plasmo build && node scripts/copy-vision.mjs build/chrome-mv3-prod",
    "package": "npm run build && plasmo package",
    "test": "node --test tests/*.test.mjs",
    "test:bundle": "node --test tests/bundle.test.mjs",
    "typecheck": "tsc --noEmit",
    "copy-vision:dev": "node scripts/copy-vision.mjs build/chrome-mv3-dev",
    "release": "npm run package && node scripts/make-release.mjs"
  },
  "dependencies": {
    "@decartai/sdk": "^0.2.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.12",
    "plasmo": "0.90.5",
    "typescript": "^5.7.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "action": {
      "default_title": "Open Pruwear fitting room",
      "default_popup": "popup.html"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/room.html",
          "options.html"
        ],
        "matches": [
          "http://*/*",
          "https://*/*"
        ]
      }
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "externally_connectable": {
      "matches": [
        "http://localhost/*"
      ]
    }
  }
}
